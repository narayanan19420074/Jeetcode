        "output": "\"blue is sky the\""
      }
    ],
    "constraints": [
      "1 <= s.length <= 10^4"
    ],
    "functionName": "reverseWords",
    "params": [
      {
        "name": "s",
        "type": "string"
      }
    ],
    "returnType": "string",
    "testCases": [
      {
        "args": [
          "the sky is blue"
        ],
        "expected": "blue is sky the",
        "isSample": true
      },
      {
        "args": [
          "  hello world  "
        ],
        "expected": "world hello",
        "isSample": true
      },
      {
        "args": [
          "a good   example"
        ],
        "expected": "example good a",
        "isSample": false
      }
    ],
    "isPublished": true
  },
