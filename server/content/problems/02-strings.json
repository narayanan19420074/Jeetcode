[
  {
    "title": "Valid Anagram",
    "difficulty": "Easy",
    "tags": [
      "String",
      "Hash Table",
      "Sorting"
    ],
    "companies": [
      "Amazon",
      "Uber"
    ],
    "description": "Given two strings, determine if the second is an anagram of the first (uses exactly the same letters, same counts, any order).",
    "examples": [
      {
        "input": "s = \"anagram\", t = \"nagaram\"",
        "output": "true"
      }
    ],
    "constraints": [
      "1 <= s.length, t.length <= 5*10^4"
    ],
    "functionName": "isAnagram",
    "params": [
      {
        "name": "s",
        "type": "string"
      },
      {
        "name": "t",
        "type": "string"
      }
    ],
    "returnType": "bool",
    "testCases": [
      {
        "args": [
          "anagram",
          "nagaram"
        ],
        "expected": true,
        "isSample": true
      },
      {
        "args": [
          "rat",
          "car"
        ],
        "expected": false,
        "isSample": true
      },
      {
        "args": [
          "a",
          "ab"
        ],
        "expected": false,
        "isSample": false
      },
      {
        "args": [
          "",
          ""
        ],
        "expected": true,
        "isSample": false
      }
    ],
    "isPublished": true
  },
