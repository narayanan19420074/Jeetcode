        "output": "6"
      }
    ],
    "constraints": [
      "1 <= tasks.length <= 10^4"
    ],
    "functionName": "taskScheduler",
    "params": [
      {
        "name": "tasks",
        "type": "string"
      },
      {
        "name": "n",
        "type": "int"
      }
    ],
    "returnType": "int",
    "testCases": [
      {
        "args": [
          "AAABBB",
          2
        ],
        "expected": 8,
        "isSample": true
      },
      {
        "args": [
          "AAAAA",
          0
        ],
        "expected": 5,
        "isSample": true
      },
      {
        "args": [
          "AAABBB",
          0
        ],
        "expected": 6,
        "isSample": false
      }
    ],
    "isPublished": true
  }
