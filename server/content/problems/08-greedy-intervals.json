        "output": "7"
      }
    ],
    "constraints": [
      "1 <= prices.length <= 3*10^4"
    ],
    "functionName": "maxProfitMultipleTransactions",
    "params": [
      {
        "name": "prices",
        "type": "int[]"
      }
    ],
    "returnType": "int",
    "testCases": [
      {
        "args": [
          [
            7,
            1,
            5,
            3,
            6,
            4
          ]
        ],
        "expected": 7,
        "isSample": true
      },
      {
        "args": [
          [
            1,
            2,
            3,
            4,
            5
          ]
        ],
        "expected": 4,
        "isSample": true
      },
      {
        "args": [
          [
            7,
            6,
            4,
            3,
            1
          ]
        ],
        "expected": 0,
        "isSample": false
      }
    ],
    "isPublished": true
  },
  {
    "title": "Gas Station",
