    "tags": [
      "Array",
      "Greedy"
    ],
    "companies": [
      "Amazon"
    ],
    "description": "There are n gas stations along a circular route, with gas[i] fuel available and cost[i] fuel required to travel to the next station. Return the starting station index from which you can complete the full circuit, or -1 if it's impossible. Assume a unique solution exists if one is possible.",
    "examples": [
      {
        "input": "gas = [1,2,3,4,5], cost = [3,4,5,1,2]",
        "output": "3"
      }
    ],
    "constraints": [
      "n == gas.length == cost.length",
      "1 <= n <= 10^5"
    ],
    "functionName": "canCompleteCircuit",
    "params": [
      {
        "name": "gas",
        "type": "int[]"
      },
      {
        "name": "cost",
        "type": "int[]"
      }
    ],
    "returnType": "int",
    "testCases": [
      {
        "args": [
          [
            1,
            2,
            3,
            4,
            5
          ],
          [
            3,
            4,
            5,
            1,
            2
          ]
        ],
        "expected": 3,
        "isSample": true
      },
      {
        "args": [
          [
            2,
            3,
            4
          ],
          [
            3,
            4,
            3
          ]
        ],
        "expected": -1,
        "isSample": true
      },
      {
        "args": [
          [
            5,
            1,
            2,
            3,
            4
          ],
          [
            4,
            4,
            1,
            5,
            1
          ]
        ],
        "expected": 4,
        "isSample": false
      }
    ],
    "isPublished": true
  },
