  {
    "title": "Baseball Game Score",
    "difficulty": "Easy",
    "tags": [
      "Stack",
      "Simulation"
    ],
    "companies": [
      "Amazon"
    ],
    "description": "You are keeping score for a baseball game with unusual rules. Given a list of operations as strings \u2014 an integer (a new score), 'C' (invalidate the previous score), 'D' (double the previous score), or '+' (sum of the previous two valid scores) \u2014 return the total of all scores remaining after applying every operation in order.",
    "examples": [
      {
        "input": "ops = [\"5\",\"2\",\"C\",\"D\",\"+\"]",
        "output": "30"
      }
    ],
    "constraints": [
      "1 <= ops.length <= 1000"
    ],
    "functionName": "baseballGameScore",
    "params": [
      {
        "name": "ops",
        "type": "string[]"
      }
    ],
    "returnType": "int",
    "testCases": [
      {
        "args": [
          [
            "5",
            "2",
            "C",
            "D",
            "+"
          ]
        ],
        "expected": 30,
        "isSample": true
      },
      {
        "args": [
          [
            "5",
            "-2",
            "4",
            "C",
            "D",
            "9",
            "+",
            "+"
          ]
        ],
        "expected": 27,
        "isSample": true
      },
      {
        "args": [
          [
            "1"
          ]
        ],
        "expected": 1,
        "isSample": false
      }
    ],
    "isPublished": true
  },
  {
