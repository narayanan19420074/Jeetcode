    "difficulty": "Easy",
    "tags": [
      "String",
      "Stack",
      "Two Pointers"
    ],
    "companies": [
      "Google",
      "Facebook"
    ],
    "description": "Given two strings that may contain '#' characters representing a backspace (deleting the previous character), determine whether the two strings are equal after applying all backspaces.",
    "examples": [
      {
        "input": "s = \"ab#c\", t = \"ad#c\"",
        "output": "true"
      }
    ],
    "constraints": [
      "1 <= s.length, t.length <= 200"
    ],
    "functionName": "backspaceCompare",
    "params": [
      {
        "name": "s",
        "type": "string"
      },
      {
        "name": "t",
        "type": "string"
      }
    ],
    "returnType": "bool",
    "testCases": [
      {
        "args": [
          "ab#c",
          "ad#c"
        ],
        "expected": true,
        "isSample": true
      },
      {
        "args": [
          "ab##",
          "c#d#"
        ],
        "expected": true,
        "isSample": true
      },
      {
        "args": [
          "a#c",
          "b"
        ],
        "expected": false,
        "isSample": false
      }
    ],
    "isPublished": true
  },
