      }
    ],
    "returnType": "int[]",
    "testCases": [
      {
        "args": [
          [
            4,
            1,
            2
          ],
          [
            1,
            3,
            4,
            2
          ]
        ],
        "expected": [
          -1,
          3,
          -1
        ],
        "isSample": true
      },
      {
        "args": [
          [
            2,
            4
          ],
          [
            1,
            2,
            3,
            4
          ]
        ],
        "expected": [
          3,
          -1
        ],
        "isSample": true
      },
      {
        "args": [
          [
            1,
            3,
            5,
            2,
            4
          ],
          [
            6,
            5,
            4,
