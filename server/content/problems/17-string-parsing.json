      "String",
      "Two Pointers"
    ],
    "companies": [
      "Google",
      "Facebook"
    ],
    "description": "Given a string containing letters and non-letter characters, reverse only the positions of the letters, leaving all other characters in their original positions.",
    "examples": [
      {
        "input": "s = \"ab-cd\"",
        "output": "\"dc-ba\""
      }
    ],
    "constraints": [
      "1 <= s.length <= 100"
    ],
    "functionName": "reverseOnlyLetters",
    "params": [
      {
        "name": "s",
        "type": "string"
      }
    ],
    "returnType": "string",
    "testCases": [
      {
        "args": [
          "ab-cd"
        ],
        "expected": "dc-ba",
        "isSample": true
      },
      {
        "args": [
          "a-bC-dEf-ghIj"
        ],
        "expected": "j-Ih-gfE-dCba",
        "isSample": true
      },
      {
        "args": [
          "Test1ng-Leet=code-Q!"
        ],
        "expected": "Qedo1ct-eeLg=ntse-T!",
        "isSample": false
      }
    ],
    "isPublished": true
  },
