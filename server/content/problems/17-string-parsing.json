    ],
    "functionName": "goatLatin",
    "params": [
      {
        "name": "sentence",
        "type": "string"
      }
    ],
    "returnType": "string",
    "testCases": [
      {
        "args": [
          "I speak Goat Latin"
        ],
        "expected": "Imaa peaksmaaa oatGmaaaa atinLmaaaaa",
        "isSample": true
      },
      {
        "args": [
          "The quick brown fox jumped over the lazy dog"
        ],
        "expected": "heTmaa uickqmaaa rownbmaaaa oxfmaaaaa umpedjmaaaaaa overmaaaaaaa hetmaaaaaaaa azylmaaaaaaaaa ogdmaaaaaaaaaa",
        "isSample": true
      }
    ],
    "isPublished": true
  },
  {
    "title": "Longest Word in Dictionary Through Deleting",
    "difficulty": "Medium",
    "tags": [
      "String",
      "Sorting",
      "Two Pointers"
    ],
    "companies": [
      "Google"
    ],
    "description": "Given a string s and a list of candidate words, return the longest word in the list that can be formed by deleting some characters from s without reordering the rest. If there's a tie, return the lexicographically smallest. Return an empty string if no word qualifies.",
    "examples": [
      {
        "input": "s = \"abpcplea\", dictionary = [\"ale\",\"apple\",\"monkey\",\"plea\"]",
        "output": "\"apple\""
      }
    ],
    "constraints": [
      "1 <= s.length <= 1000"
    ],
    "functionName": "longestWordInDictionaryThroughDeleting",
    "params": [
      {
        "name": "s",
        "type": "string"
      },
      {
        "name": "dictionary",
        "type": "string[]"
      }
    ],
    "returnType": "string",
    "testCases": [
      {
        "args": [
          "abpcplea",
          [
            "ale",
            "apple",
            "monkey",
            "plea"
          ]
        ],
        "expected": "apple",
        "isSample": true
      },
      {
        "args": [
          "abpcplea",
          [
            "a",
            "b",
            "c"
          ]
        ],
        "expected": "a",
        "isSample": true
      }
    ],
    "isPublished": true
  },
