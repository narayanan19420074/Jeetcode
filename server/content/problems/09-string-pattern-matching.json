        "output": "\"a2bc5a3\""
      }
    ],
    "constraints": [
      "1 <= s.length <= 2000"
    ],
    "functionName": "stringCompression",
    "params": [
      {
        "name": "s",
        "type": "string"
      }
    ],
    "returnType": "string",
    "testCases": [
      {
        "args": [
          "aabcccccaaa"
        ],
        "expected": "a2bc5a3",
        "isSample": true
      },
      {
        "args": [
          "abbbbbbbbbbbb"
        ],
        "expected": "ab12",
        "isSample": true
      },
      {
        "args": [
          "abc"
        ],
        "expected": "abc",
        "isSample": false
      }
    ],
    "isPublished": true
