  {
    "title": "Implement strStr()",
    "difficulty": "Easy",
    "tags": [
      "String",
      "Two Pointers"
    ],
    "companies": [
      "Amazon",
      "Microsoft"
    ],
    "description": "Given two strings haystack and needle, return the index of the first occurrence of needle in haystack, or -1 if needle is not part of haystack.",
    "examples": [
      {
        "input": "haystack = \"sadbutsad\", needle = \"sad\"",
        "output": "0"
      }
    ],
    "constraints": [
      "1 <= haystack.length, needle.length <= 10^4"
    ],
    "functionName": "strStr",
    "params": [
      {
        "name": "haystack",
        "type": "string"
      },
      {
        "name": "needle",
        "type": "string"
      }
    ],
    "returnType": "int",
    "testCases": [
      {
        "args": [
          "sadbutsad",
          "sad"
        ],
        "expected": 0,
        "isSample": true
      },
      {
        "args": [
          "leetcode",
          "leeto"
        ],
        "expected": -1,
        "isSample": true
      },
      {
        "args": [
          "hello",
          "ll"
        ],
        "expected": 2,
        "isSample": false
      }
    ],
    "isPublished": true
  },
