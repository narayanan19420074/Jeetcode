        "args": [
          "1.01",
          "1.001"
        ],
        "expected": 0,
        "isSample": true
      },
      {
        "args": [
          "1.0",
          "1.0.0"
        ],
        "expected": 0,
        "isSample": true
      },
      {
        "args": [
          "0.1",
          "1.1"
