    "title": "Zigzag Conversion",
    "difficulty": "Medium",
    "tags": [
      "String"
    ],
    "companies": [
      "Amazon",
      "PayPal"
    ],
    "description": "Given a string and a number of rows, write the string in a zigzag pattern across that many rows, then read it row by row and return the resulting string.",
    "examples": [
      {
        "input": "s = \"PAYPALISHIRING\", numRows = 3",
        "output": "\"PAHNAPLSIIGYIR\""
      }
    ],
    "constraints": [
      "1 <= s.length <= 1000",
      "1 <= numRows <= 1000"
    ],
    "functionName": "zigzagConvert",
    "params": [
      {
        "name": "s",
        "type": "string"
      },
      {
        "name": "numRows",
        "type": "int"
      }
    ],
    "returnType": "string",
    "testCases": [
      {
        "args": [
          "PAYPALISHIRING",
          3
        ],
        "expected": "PAHNAPLSIIGYIR",
        "isSample": true
      },
      {
        "args": [
          "PAYPALISHIRING",
          4
        ],
        "expected": "PINALSIGYAHRPI",
        "isSample": true
      },
      {
        "args": [
          "A",
          1
        ],
        "expected": "A",
        "isSample": false
      }
    ],
    "isPublished": true
  },
