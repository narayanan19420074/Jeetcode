      },
      {
        "name": "t",
        "type": "string"
      }
    ],
    "returnType": "bool",
    "testCases": [
      {
        "args": [
          "egg",
          "add"
        ],
        "expected": true,
        "isSample": true
      },
      {
        "args": [
          "foo",
          "bar"
        ],
        "expected": false,
        "isSample": true
      },
      {
        "args": [
          "paper",
          "title"
        ],
        "expected": true,
        "isSample": false
      }
    ],
    "isPublished": true
