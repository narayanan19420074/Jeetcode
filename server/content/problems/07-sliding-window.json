        "output": "12.75"
      }
    ],
    "constraints": [
      "1 <= k <= nums.length <= 10^5"
    ],
    "functionName": "maxAverageSubarray",
    "params": [
      {
        "name": "nums",
        "type": "int[]"
      },
      {
        "name": "k",
        "type": "int"
      }
    ],
    "returnType": "float",
    "testCases": [
      {
        "args": [
          [
            1,
            12,
            -5,
            -6,
            50,
            3
          ],
          4
        ],
        "expected": 12.75,
        "isSample": true
      },
      {
        "args": [
          [
            5
          ],
          1
        ],
        "expected": 5.0,
        "isSample": true
      },
      {
        "args": [
          [
            0,
            4,
            0,
            3,
            2
          ],
          1
        ],
        "expected": 4.0,
        "isSample": false
      }
    ],
    "isPublished": true
  },
