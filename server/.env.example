NODE_ENV=development
PORT=5000

# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/<db>?retryWrites=true&w=majority

# JWT Secrets (Generate strong random secrets in production)
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# Frontend URL
CLIENT_ORIGIN=http://localhost:5173

# Judge: local (own judge on this server, default) or judge0 (external API)
JUDGE_MODE=local
JUDGE_TIME_LIMIT_MS=8000
JUDGE_MEMORY_MB=256
JUDGE_CONCURRENCY=2

# Judge0 Setup (only used when JUDGE_MODE=judge0)
JUDGE0_API_URL=https://ce.judge0.com
JUDGE0_API_KEY=
JUDGE0_API_HOST=

# Optional Redis
REDIS_URL=

# Email (forgot password + verification). Free: Brevo, 300 mails/day, no domain needed.
# Brevo -> SMTP & API -> API keys. MAIL_FROM_EMAIL must be a verified sender in Brevo.
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=JeetCode
# Public site URL for email links (on Render it falls back to RENDER_EXTERNAL_URL)
APP_URL=

# AI hints (workspace AI Assistant). Set ONE key; Gemini is tried first.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Payments: self-hosted YouPI PG (UPI). Set in Render -> Environment.
YOUPI_API_URL=
YOUPI_MERCHANT_ID=
YOUPI_WEBHOOK_SECRET=
