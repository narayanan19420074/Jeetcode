VITE_API_BASE_URL=http://localhost:5000/api

# Sentry DSN for browser crash reports (public key, safe in the client). Leave empty to turn error reporting off.
VITE_SENTRY_DSN=

# Cloudflare Turnstile public site key. Leave empty to hide the check (the server must then have no secret either).
# For local testing Cloudflare's always-pass test site key is 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=
